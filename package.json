{
  "name": "nova-plus-rollup",
  "version": "1.1.1",
  "description": "Rollup build of the nova-plus Vue component library",
  "private": true,
  "main": "./dist/lib/index.cjs",
  "module": "./dist/es/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/es/index.mjs",
      "require": "./dist/lib/index.cjs"
    },
    "./es/*": "./dist/es/*",
    "./lib/*": "./dist/lib/*"
  },
  "files": ["dist"],
  "scripts": {
    "build": "rollup -c scripts/rollup.config.prod.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:all": "npm run build && npm run build:types",
    "start": "rollup -cw scripts/rollup.config.dev.mjs",
    "test": "node --test"
  },
  "keywords": ["vue", "component-library", "rollup", "code-editor", "json-virtual-table"],
  "author": "Thales",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.3.4",
    "vxe-table": "4.3.9"
  },
  "dependencies": {
    "monaco-editor": "^0.40.0",
    "sortablejs": "^1.15.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^5.0.5",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.14.15",
    "@types/sortablejs": "^1.15.8",
    "@types/uuid": "^9.0.8",
    "rollup": "^4.19.1",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.77.8",
    "typescript": "~5.0.4",
    "vue": "3.3.4",
    "vxe-table": "4.3.9"
  }
}
